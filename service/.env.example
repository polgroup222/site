# Скопіюйте у .env і заповніть. Файл .env у git НЕ додавати.
DOMAIN=api.vash-domen.rs
PUBLIC_URL=https://api.vash-domen.rs
# CORS: лише ваш власний сайт (через кому), напр. https://cestitam.eu,https://www.cestitam.eu.
# Якщо сайт і сервіс на одному домені — залиште порожнім (тоді чужі сайти взагалі не можуть звертатися до API).
ALLOWED_ORIGINS=
# довгий випадковий пароль для адмінки (щонайменше 24 символи, напр. openssl rand -hex 24).
# Вхід: https://api.vash-domen.rs/admin/login → вставити токен у поле (у адресі токен більше не працює)
ADMIN_TOKEN=
# ще безпечніше: замість ADMIN_TOKEN зберігати лише його хеш (тоді рядок ADMIN_TOKEN видаліть):
#   printf '%s' 'ВАШ_ТОКЕН' | sha256sum   → ADMIN_TOKEN_SHA256=отримані_64_символи
ADMIN_TOKEN_SHA256=
# прихована адреса входу в адмінку (за замовчуванням /admin/login), напр. /admin/vhid-7f3k9q
ADMIN_LOGIN_PATH=
# ElevenLabs: ключ і id голосу «ded mrez»
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# manual = ви позначаєте «оплачено» в адмінці; none = одразу в рендер БЕЗ оплати (лише для тесту!)
# mock = кнопка «Оплата успішна» лише для тестових замовлень з адмінки (для всіх — тільки з MOCK_PAY_ALL=1, небезпечно)
PAYMENT_MODE=manual
# 1 = ролик без зауважень іде клієнту сам; порожньо = після вашої перевірки
AUTO_SEND=
# лист клієнту (resend.com, безкоштовно до 3000 листів/міс). Без ключа посилання видно в адмінці.
RESEND_API_KEY=
MAIL_FROM=Zimska pošta <cestitke@vash-domen.rs>
# Telegram-сповіщення власнику (агенти): токен бота від @BotFather і ваш chat id
TG_BOT_TOKEN=
TG_CHAT_ID=
# ранкова зведення: година і часовий пояс власника
SUMMARY_HOUR=8
OWNER_TZ=Europe/Kiev
# Google-таблиця оплачених замовлень (tools/google-sheet.gs): URL веб-застосунку і пароль з цього скрипта
SHEET_WEBHOOK=
SHEET_SECRET=
# копія бекапу поза сервером: пароль шифрування (AES-256). Якщо задано разом із Telegram, щоденний бекап іде вам у Telegram зашифрованим.
# Пароль збережіть окремо (менеджер паролів): без нього бекап не відкрити.
BACKUP_PASS=
