# Скопіюйте у .env і заповніть. Файл .env у git НЕ додавати.
DOMAIN=api.vash-domen.rs
PUBLIC_URL=https://api.vash-domen.rs
# сайт, з якого дозволено надсилати замовлення (через кому)
ALLOWED_ORIGINS=https://polgroup222.github.io
# довгий випадковий пароль для адмінки: https://api.vash-domen.rs/admin/login?token=...
ADMIN_TOKEN=
# ElevenLabs: ключ і id голосу «ded mrez»
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# manual = ви позначаєте «оплачено» в адмінці; none = одразу в рендер (для тесту)
PAYMENT_MODE=manual
# 1 = ролик без зауважень іде клієнту сам; порожньо = після вашої перевірки
AUTO_SEND=
# лист клієнту (resend.com, безкоштовно до 3000 листів/міс). Без ключа посилання видно в адмінці.
RESEND_API_KEY=
MAIL_FROM=Zimska pošta <cestitke@vash-domen.rs>
# Telegram-сповіщення власнику (агенти): токен бота від @BotFather і ваш chat id
TG_BOT_TOKEN=
TG_CHAT_ID=
# ранкова зведення: година і часовий пояс власника
SUMMARY_HOUR=8
OWNER_TZ=Europe/Kiev
# Google-таблиця оплачених замовлень (tools/google-sheet.gs): URL веб-застосунку і пароль з цього скрипта
SHEET_WEBHOOK=
SHEET_SECRET=
# AI-підтримка (чат на сайті): ключ з console.anthropic.com -> API keys. Без ключа працюють лише кнопки й оператор.
ANTHROPIC_API_KEY=
# ліміт витрат AI на добу в доларах (при 80% і 100% — повідомлення в Telegram і в CRM)
SUPPORT_DAILY_USD=1
# 0 = не читати команди бота (/reply, /tickets, /close). Увімкнено, якщо є TG_BOT_TOKEN і TG_CHAT_ID.
SUPPORT_TG_POLL=
