{$DOMAIN} {
  encode gzip
  request_body {
    max_size 20MB
  }
  # сервіс замовлень
  @app path /api/* /o/* /porudzbina /admin /admin/* /health
  handle @app {
    reverse_proxy app:8080
  }
  # сайт: лише явно дозволені файли з кореня репозиторію (service/, .env і .git не віддаються)
  @site path / /index.html /privacy.html /app.js /style.css /fonts/* /img/*
  handle @site {
    root * /srv/site
    # сторінка, скрипт і стилі завжди перевіряються (ETag), щоб після оновлення не змішувались стара й нова версії
    @code path / /index.html /privacy.html /app.js /style.css
    header @code Cache-Control "no-cache"
    @static path /fonts/* /img/*
    header @static Cache-Control "public, max-age=86400"
    file_server
  }
  # відео для головної: оригінали з /root/media на сервері, без перестиснення (у git не зберігаємо)
  @media path /media/*
  handle @media {
    root * /srv
    header Cache-Control "public, max-age=86400"
    file_server
  }
  handle {
    respond 404
  }
}
