<?xml version="1.0" encoding="UTF-8"?>
<!-- Обмеження ImageMagick для фото клієнтів. На якість не впливає: розміри з запасом для будь-якого фото з телефону (до 16000 px, 200 Мп). -->
<policymap>
  <policy domain="resource" name="memory" value="2GiB"/>
  <policy domain="resource" name="map" value="4GiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="200MP"/>
  <policy domain="resource" name="disk" value="8GiB"/>
  <policy domain="resource" name="time" value="600"/>
  <!-- небезпечні формати і трюки (читання файлів через @, мережа, скрипти, PostScript/PDF/SVG) вимкнені -->
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="coder" rights="none" pattern="{URL,HTTP,HTTPS,FTP,MVG,MSL,EPHEMERAL,TEXT,SHOW,WIN,X,PLT,PS,PS2,PS3,EPS,EPI,EPSF,EPSI,EPT,PDF,PDFA,XPS,SVG,MSVG,RSVG,SVGZ,MPC,CACHE,DOT,GV,HTML,HTM,PWP,SCR,VID,MAT}"/>
</policymap>
